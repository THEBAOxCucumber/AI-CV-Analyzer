# ค่าตัวอย่างสำหรับ docker-compose.yml (root) — copy เป็น .env แล้วแก้
# บน VPS ใช้ deploy/make-env.sh สร้างให้ (สุ่มรหัสผ่านให้อัตโนมัติ)
# ห้าม commit .env จริง

# ---------- Image / port ----------
# ในเครื่อง: ไม่ต้องตั้ง (override build ให้)  บน VPS: image จาก GHCR
APP_IMAGE=ghcr.io/thebaoxcucumber/ai-cv-analyzer:latest
MIGRATOR_IMAGE=ghcr.io/thebaoxcucumber/ai-cv-analyzer-migrator:latest
# port บนเครื่อง (bind 127.0.0.1 เท่านั้น) — แอป Lab ใช้ 3300
APP_PORT=3310
# "ai" = เริ่ม Ollama ด้วยทุกครั้งที่ docker compose up (ว่าง = ไม่เปิด)
COMPOSE_PROFILES=

# ---------- Database ----------
DB_NAME=ai_resume_analyzer
DB_USER=resume_user
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ---------- App ----------
NODE_ENV=production
# อย่างน้อย 32 ตัวอักษร: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m

# URL ที่ผู้ใช้เปิดเว็บ (ใช้กับ CORS / ลิงก์ในอีเมล / Google sign-in)
CORS_ORIGIN=https://cv.example.com
FRONTEND_URL=https://cv.example.com
OAUTH_PUBLIC_BASE_URL=https://cv.example.com

# ---------- AI ----------
# ต้องเปิด --profile ai (หรือตั้ง OLLAMA_HOST ไปเครื่องอื่น) ถึงจะวิเคราะห์ได้
OLLAMA_MODEL=qwen3:4b-instruct
# embedding: ollama (ต้องเปิด profile ai) หรือ gemini (ต้องมี GEMINI_API_KEY)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
QDRANT_COLLECTION=resume_chunks_ollama_qwen3_1024
GEMINI_API_KEY=

# ---------- บริการภายนอก ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# backend บังคับให้มีค่า — ยังไม่มี key ใส่ค่าอะไรก็ได้ไปก่อน (ค้นหางานจะใช้ไม่ได้)
CAREERJET_API_KEY=unset
# ไม่ได้ใช้แล้ว แต่ backend ยังบังคับให้มีค่า
JOOBLE_API_KEY=unused
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
